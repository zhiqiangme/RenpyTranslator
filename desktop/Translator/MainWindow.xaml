<Window x:Class="RenpyTranslator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ren'Py 汉化管理器" Width="1060" Height="820" MinWidth="850" MinHeight="650" Background="#F3F6FB" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="Ren'Py 汉化管理器" FontSize="28" FontWeight="SemiBold" Foreground="#162C49"/><TextBlock Text="安装汉化 · 管理模型 · 更新资源" Foreground="#63748A" Margin="0,6,0,0"/></StackPanel>
  <TabControl x:Name="Pages" Grid.Row="1" BorderThickness="0" Background="White">
   <TabItem Header="游戏管理"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <TextBlock Text="游戏目录" FontSize="19" FontWeight="SemiBold"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="浏览…" Click="Browse"/><ComboBox x:Name="Games" IsEditable="True" MinWidth="480" SelectionChanged="GameSelected"/></DockPanel>
    <WrapPanel><Button Content="读取 / 检查状态" Click="Reload"/><Button Content="打开游戏目录" Click="OpenGame"/></WrapPanel>
    <TextBlock x:Name="GameStatus" Text="选择游戏根目录，读取已有配置。" Foreground="#246EB9" Margin="0,8,0,20"/>
    <TextBlock Text="汉化资源" FontWeight="SemiBold"/><ComboBox x:Name="Pack" SelectedIndex="0"><ComboBoxItem Content="通用实时翻译（不导入专属译文）"/><ComboBoxItem Content="Camp Buddy Scoutmaster Season 专属译文"/></ComboBox>
    <TextBlock Text="专属译文仅适用于对应游戏。通用模式保留游戏已有的预译文；切换模式不会自动删除这些译文。" Foreground="#63748A"/>
    <TextBlock Text="中文字体" Margin="0,18,0,0" FontWeight="SemiBold"/><ComboBox x:Name="FontChoice" SelectedIndex="0"><ComboBoxItem Content="HarmonyOS Sans SC（内置）"/><ComboBoxItem Content="微软雅黑（系统字体）"/><ComboBoxItem Content="宋体（系统字体）"/></ComboBox>
    <WrapPanel><Button Content="安装 / 升级 / 修复汉化" Click="Install" Background="#246EB9" Foreground="White"/><Button Content="卸载汉化" Click="Uninstall"/></WrapPanel>
    <CheckBox x:Name="RemoveData" Content="卸载时同时清理 API 配置与翻译缓存" Margin="0,12,0,0"/>
    <TextBlock Text="安装后可关闭管理器。游戏内 F9 开关翻译，F10 查看状态。修改配置后请重新启动游戏。" Margin="0,24,0,0" Foreground="#63748A"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="模型 API"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <TextBlock Text="OpenAI 兼容接口" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="预设沿用旧版，仅供填写参考；地址与模型以服务商账户实际支持为准。" Margin="0,8,0,12" Foreground="#63748A"/>
    <ComboBox x:Name="Provider" SelectionChanged="ProviderChanged"/>
    <TextBlock Text="API 地址"/><TextBox x:Name="BaseUrl"/>
    <TextBlock Text="模型名称"/><TextBox x:Name="Model"/>
    <TextBlock Text="API Key（留空保留已有密钥）"/><PasswordBox x:Name="ApiKey" Padding="9" Margin="0,4,0,10"/>
    <CheckBox x:Name="ClearKey" Content="清除已保存的密钥"/><TextBlock x:Name="KeyStatus" Foreground="#63748A" Margin="0,8,0,10"/>
    <WrapPanel><Button Content="保存配置" Click="Save"/><Button Content="测试连接 / 翻译" Click="TestApi"/></WrapPanel>
    <TextBlock Text="测试会向所填地址发送一条 Hello 翻译请求，可能产生少量费用。密钥使用当前 Windows 用户的 DPAPI 加密存储。" Foreground="#63748A"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="高级设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Advanced" Margin="24"><TextBlock Text="翻译参数" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="更改后点击保存。恢复默认只更改编辑区，不立即写入游戏。" Margin="0,8,0,12"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="更新"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <TextBlock Text="软件与汉化资源" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="ManagerVersion" Margin="0,12,0,0"/><TextBlock x:Name="ResourceVersion" Margin="0,6,0,12"/>
    <WrapPanel><Button Content="检查 GitHub 更新" Click="CheckUpdate"/><Button x:Name="UpdateButton" Content="下载并重启更新" Click="ApplyUpdate" IsEnabled="False"/></WrapPanel>
    <TextBox x:Name="ReleaseNotes" IsReadOnly="True" TextWrapping="Wrap" Height="250" VerticalScrollBarVisibility="Auto" Text="更新来源：zhiqiangme/renpy-translator。新版本必须包含桌面发行包与校验文件。"/>
    <TextBlock Text="更新管理器后，在游戏管理页点击安装 / 升级，便可将新模组和译文应用到选中的游戏。配置与缓存会保留。" Foreground="#63748A"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="数据与日志"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
    <TextBlock Text="译文与缓存" FontSize="19" FontWeight="SemiBold"/><WrapPanel><Button Content="校验内置译文" Click="ValidateTranslations"/><Button Content="导出缓存" Click="ExportCache"/><Button Content="备份并清空缓存" Click="ClearCache"/><Button Content="打开备份目录" Click="OpenBackups"/></WrapPanel>
    <WrapPanel><Button Content="导出操作日志" Click="ExportLog"/><Button Content="打开游戏数据目录" Click="OpenData"/></WrapPanel>
    <TextBox x:Name="LogBox" Height="310" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><ProgressBar x:Name="Progress" Height="4" Visibility="Collapsed" IsIndeterminate="True"/><TextBlock x:Name="StatusText" Text="就绪" Margin="0,8,0,0" Foreground="#63748A"/></StackPanel>
 </Grid>
</Window>
