<Window x:Class="RenpyTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ren'Py 汉化管理器" Width="1120" Height="780" MinWidth="960" MinHeight="640"
        Background="{StaticResource WindowBrush}" FontFamily="Microsoft YaHei UI" FontSize="{StaticResource FontBody}"
        Icon="/Assets/app.ico" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Grid Background="{StaticResource WindowBrush}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- 五个页面，导航外观由 Themes/Controls.xaml 中的 TabControl / TabItem 模板重塑为左侧导航栏 -->
  <TabControl x:Name="Pages" Grid.Row="0">
   <TabItem>
    <TabItem.Header>
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource IconGame}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Width="16" Height="16" VerticalAlignment="Center"/>
      <TextBlock Text="游戏管理" Margin="10,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="28,26,0,28">
      <TextBlock Text="游戏管理" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="选择 Ren'Py 游戏根目录，安装、升级或修复汉化" Style="{StaticResource PageSubtitle}"/>

      <Border Style="{StaticResource Card}" Margin="0,20,0,14">
       <StackPanel>
        <TextBlock Text="游戏目录" Style="{StaticResource FieldLabel}"/>
        <StackPanel Orientation="Horizontal">
         <ComboBox x:Name="Games" IsEditable="True" Width="420" SelectionChanged="GameSelected"/>
         <Button Content="浏览…" Click="Browse" Margin="8,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
         <Button Content="读取 / 检查状态" Click="Reload"/>
         <Button Content="打开游戏目录" Click="OpenGame"/>
        </StackPanel>
        <Border Background="{StaticResource SurfaceSunkenBrush}" CornerRadius="{StaticResource RadiusMd}" Padding="12,9" Margin="0,4,0,0">
         <TextBlock x:Name="GameStatus" Text="选择游戏根目录，读取已有配置。" Style="{StaticResource Status}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        </Border>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="汉化资源" Style="{StaticResource SectionTitle}"/>
        <ComboBox x:Name="Pack" SelectedIndex="0" Width="420" HorizontalAlignment="Left" SelectionChanged="PackChanged">
         <ComboBoxItem Content="通用实时翻译（不导入专属译文）"/>
         <ComboBoxItem Content="Camp Buddy Scoutmaster Season 专属译文"/>
         <ComboBoxItem Content="自定义汉化包（选择 JSONL 文件夹）"/>
        </ComboBox>
        <StackPanel x:Name="CustomPackPanel" Visibility="Collapsed" Margin="0,12,0,0">
         <TextBlock Text="汉化包文件夹" Style="{StaticResource FieldLabel}"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="CustomPackDirectory" IsReadOnly="True" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <Button Grid.Column="1" Content="选择文件夹…" Click="BrowseCustomPack" Margin="8,0,0,0"/>
         </Grid>
         <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="读取该目录及子目录中的全部 JSONL，校验后合并替换游戏已有预译文，并先备份。仅导入译文，保留游戏原确认屏幕；原汉化包不修改。"/>
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="专属译文仅适用于对应游戏。通用模式保留游戏已有的预译文；切换模式不会自动删除这些译文。"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="中文字体" Style="{StaticResource SectionTitle}"/>
        <ComboBox x:Name="FontChoice" SelectedIndex="0" Width="420" HorizontalAlignment="Left">
         <ComboBoxItem Content="黑体（系统字体，默认）"/>
         <ComboBoxItem Content="微软雅黑（系统字体）"/>
         <ComboBoxItem Content="宋体（系统字体）"/>
        </ComboBox>
        <TextBlock Style="{StaticResource Hint}" Text="系统字体直接引用本机字体文件，不再随汉化复制；默认优先使用黑体，本机缺失时回退到雅黑或宋体。"/>
       </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
       <Button Content="安装 / 升级 / 修复汉化" Click="Install" Style="{StaticResource PrimaryButton}"/>
       <Button Content="卸载汉化" Click="Uninstall" Style="{StaticResource DangerButton}"/>
      </StackPanel>
      <CheckBox x:Name="RemoveData" Content="卸载时删除 game/live_translator 内全部文件（含自行存放的文件）" Margin="0,6,0,0"/>
      <TextBlock Style="{StaticResource Hint}" Text="安装完成后可关闭管理器。游戏内 F9 开关翻译，F10 查看状态；修改配置后请重新启动游戏。"/>
     </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>

   <TabItem>
    <TabItem.Header>
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource IconApi}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Width="16" Height="16" VerticalAlignment="Center"/>
      <TextBlock Text="模型 API" Margin="10,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="28,26,0,28">
      <TextBlock Text="模型 API" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="配置 OpenAI 兼容接口，供游戏内实时翻译调用" Style="{StaticResource PageSubtitle}"/>

      <Border Style="{StaticResource Card}" Margin="0,20,0,14">
       <StackPanel>
        <TextBlock Text="服务商" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="Provider" Width="420" HorizontalAlignment="Left" SelectionChanged="ProviderChanged"/>
        <TextBlock Style="{StaticResource Hint}" Text="预设沿用旧版，仅作填写参考；实际可用地址与模型以服务商账户支持情况为准。"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="接口参数" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="API 地址" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="BaseUrl" Width="420" HorizontalAlignment="Left"/>
        <TextBlock Text="模型名称" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
        <TextBox x:Name="Model" Width="420" HorizontalAlignment="Left"/>
        <TextBlock Text="API Key（留空保留已有密钥）" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
        <PasswordBox x:Name="ApiKey" Width="420" HorizontalAlignment="Left"/>
        <CheckBox x:Name="ClearKey" Content="清除已保存的密钥" Margin="0,14,0,0"/>
        <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
       </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
       <Button Content="保存配置" Click="Save" Style="{StaticResource PrimaryButton}"/>
       <Button Content="测试连接 / 翻译" Click="TestApi"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Hint}" Text="测试会向所填地址发送一条 Hello 翻译请求，可能产生少量费用。密钥使用当前 Windows 用户的 DPAPI 加密存储。"/>
     </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>

   <TabItem>
    <TabItem.Header>
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource IconTune}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Width="16" Height="16" VerticalAlignment="Center"/>
      <TextBlock Text="高级设置" Margin="10,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="28,26,0,28">
      <TextBlock Text="高级设置" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="翻译调优参数，改动后点击保存写入游戏目录" Style="{StaticResource PageSubtitle}"/>

      <Border Style="{StaticResource Card}" Margin="0,20,0,14">
       <StackPanel>
        <TextBlock Text="请求参数" Style="{StaticResource SectionTitle}"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Grid.Column="0" Margin="0,0,14,0">
          <TextBlock Text="每批条数" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="FieldBatchSize"/>
          <TextBlock Text="请求超时（秒）" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
          <TextBox x:Name="FieldTimeout"/>
          <TextBlock Text="温度" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
          <TextBox x:Name="FieldTemperature"/>
         </StackPanel>
         <StackPanel Grid.Column="1">
          <TextBlock Text="批量等待（毫秒）" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="FieldBatchWaitMs"/>
          <TextBlock Text="重试冷却（秒）" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
          <TextBox x:Name="FieldRetryCooldown"/>
          <TextBlock Text="最大输出 token" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
          <TextBox x:Name="FieldMaxTokens"/>
         </StackPanel>
        </Grid>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="开关" Style="{StaticResource SectionTitle}"/>
        <CheckBox x:Name="FlagEnabled" Content="启用翻译"/>
        <CheckBox x:Name="FlagThinking" Content="启用思考模式" Margin="0,12,0,0"/>
        <CheckBox x:Name="FlagJsonFormat" Content="请求 JSON 格式" Margin="0,12,0,0"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="提示词与人名保护" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="翻译提示词" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="FieldSystemPrompt" MinHeight="120" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10"/>
        <TextBlock Text="保护人名（JSON 数组）" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
        <TextBox x:Name="FieldProtectedNames" MinHeight="60" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10" FontFamily="{StaticResource MonoFontFamily}"/>
        <TextBlock Text="跳过规则（JSON 数组）" Style="{StaticResource FieldLabel}" Margin="0,14,0,8"/>
        <TextBox x:Name="FieldSkipPatterns" MinHeight="60" VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap" Padding="12,10" FontFamily="{StaticResource MonoFontFamily}"/>
        <TextBlock Style="{StaticResource Hint}" Text="包含这些名字的文本不会被翻译；跳过规则支持基础正则语法，不支持命名组、反向引用或前后查找。恢复默认只改动编辑区，需再点保存才会写入游戏。"/>
       </StackPanel>
      </Border>

      <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
       <Button Content="保存配置" Click="Save" Style="{StaticResource PrimaryButton}"/>
       <Button Content="恢复翻译参数默认值" Click="RestoreDefaults"/>
      </StackPanel>
     </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>

   <TabItem>
    <TabItem.Header>
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource IconUpdate}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Width="16" Height="16" VerticalAlignment="Center"/>
      <TextBlock Text="更新" Margin="10,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="28,26,0,28">
      <TextBlock Text="更新" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="检查并安装管理器与汉化资源的新版本" Style="{StaticResource PageSubtitle}"/>

      <Border Style="{StaticResource Card}" Margin="0,20,0,14">
       <StackPanel>
        <TextBlock Text="当前版本" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="ManagerVersion" Style="{StaticResource Monitor}"/>
        <TextBlock x:Name="ResourceVersion" Style="{StaticResource Monitor}" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="检查更新" Style="{StaticResource SectionTitle}"/>
        <StackPanel Orientation="Horizontal">
         <Button Content="检查 GitHub 更新" Click="CheckUpdate"/>
         <Button x:Name="UpdateButton" Content="下载并重启更新" Click="ApplyUpdate" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
        <TextBlock x:Name="UpdateStatus" Text="更新来源：zhiqiangme/RenpyTranslator" Margin="0,12,0,0"/>
        <FlowDocumentScrollViewer x:Name="ReleaseNotes" Height="300" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" FocusVisualStyle="{x:Null}" Visibility="Collapsed"/>
       </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource Hint}" Text="更新管理器后，请在游戏管理页点击「安装 / 升级 / 修复汉化」，将新模组与译文应用到所选游戏。已有配置与缓存会保留。"/>
     </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>

   <TabItem>
    <TabItem.Header>
     <StackPanel Orientation="Horizontal">
      <Path Data="{StaticResource IconData}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="None" Width="16" Height="16" VerticalAlignment="Center"/>
      <TextBlock Text="数据与日志" Margin="10,0,0,0" VerticalAlignment="Center"/>
     </StackPanel>
    </TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="28,26,0,28">
      <TextBlock Text="数据与日志" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="校验译文、维护缓存与导出操作记录" Style="{StaticResource PageSubtitle}"/>

      <Border Style="{StaticResource Card}" Margin="0,20,0,14">
       <StackPanel>
        <TextBlock Text="译文与缓存" Style="{StaticResource SectionTitle}"/>
        <WrapPanel>
         <Button Content="校验所选译文包" Click="ValidateTranslations"/>
         <Button Content="导出缓存" Click="ExportCache"/>
         <Button Content="备份并清空缓存" Click="ClearCache"/>
         <Button Content="打开备份目录" Click="OpenBackups"/>
        </WrapPanel>
        <WrapPanel Margin="0,4,0,0">
         <Button Content="导出操作日志" Click="ExportLog"/>
         <Button Content="打开游戏数据目录" Click="OpenData"/>
        </WrapPanel>
       </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
       <StackPanel>
        <TextBlock Text="操作日志" Style="{StaticResource SectionTitle}"/>
        <TextBox x:Name="LogBox" Style="{StaticResource MonitorBox}" Height="290" IsReadOnly="True"/>
       </StackPanel>
      </Border>
     </StackPanel>
     </Grid>
    </ScrollViewer>
   </TabItem>
  </TabControl>

  <!-- 底部状态栏 -->
  <Border Grid.Row="1" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
   <Grid Margin="28,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ProgressBar x:Name="Progress" Grid.Column="0" MaxWidth="140" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" IsIndeterminate="True"/>
    <TextBlock x:Name="StatusText" Grid.Column="1" Text="就绪" Style="{StaticResource Status}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <TextBlock Grid.Column="2" Style="{StaticResource Monitor}" Text="F9 开关翻译 · F10 查看状态" TextWrapping="NoWrap" VerticalAlignment="Center"/>
   </Grid>
  </Border>
 </Grid>
</Window>
