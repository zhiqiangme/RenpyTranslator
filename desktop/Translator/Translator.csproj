<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>RenpyTranslator</AssemblyName><Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../packaging/version.txt').Trim())</Version>
    <!-- 窗口与可执行文件图标，由 packaging/make-icon.py 生成 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 作为 WPF 资源嵌入，供 Window.Icon 以 pack URI 引用 -->
    <Resource Include="Assets\app.ico" />
    <Content Include="../../game/**/*.rpy" Link="Resources/game/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- 只发布明确内置的游戏译文，不能按整个 translations 目录递归收集私人汉化包。 -->
    <Content Include="../../translations/camp-buddy-scoutmaster/*.jsonl" Link="Resources/translations/camp-buddy-scoutmaster/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../config.default.json;../../packaging/version.txt;../../LICENSE" Link="Resources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="ThirdParty/*" Link="Resources/licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
</Project>
