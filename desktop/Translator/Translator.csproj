<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>RenpyTranslator</AssemblyName><Version>1.0.0</Version>
    <!-- 窗口与可执行文件图标，由 packaging/make-icon.py 生成 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- 作为 WPF 资源嵌入，供 Window.Icon 以 pack URI 引用 -->
    <Resource Include="Assets\app.ico" />
    <Content Include="../../game/**/*.rpy" Link="Resources/game/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../translations/**/*.jsonl" Link="Resources/translations/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../fonts/**" Link="Resources/fonts/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../config.default.json;../../packaging/version.txt;../../LICENSE" Link="Resources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Content Update="../../fonts/**" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" /></ItemGroup>
</Project>
