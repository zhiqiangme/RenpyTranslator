<!--
  设计令牌：颜色、圆角、字号。
  约定：页面 XAML 中禁止直接写死颜色；尺寸只允许使用本文件的字号与圆角，间距按 4 的倍数就地书写。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">

 <!-- 表面层级：窗口底 → 次级面 → 卡片面 -->
 <SolidColorBrush x:Key="WindowBrush" Color="#F5F6F8"/>
 <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFBFC"/>
 <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F0F2F5"/>
 <!-- 交互反馈底色：悬停 / 按下 -->
 <SolidColorBrush x:Key="HoverBrush" Color="#F0F2F5"/>
 <SolidColorBrush x:Key="PressedBrush" Color="#E6E9EE"/>

 <!-- 边框：常规 / 强调（输入框描边） / 聚焦 -->
 <SolidColorBrush x:Key="BorderBrush" Color="#E8EAED"/>
 <SolidColorBrush x:Key="BorderStrongBrush" Color="#D5D9DF"/>
 <SolidColorBrush x:Key="BorderHoverBrush" Color="#BFC6CF"/>

 <!-- 文字层级 -->
 <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2328"/>
 <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6472"/>
 <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8B95A3"/>
 <SolidColorBrush x:Key="TextDisabledBrush" Color="#B4BCC7"/>
 <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

 <!-- 强调色：常态 / 悬停 / 按下 / 浅底（选中态） -->
 <SolidColorBrush x:Key="AccentBrush" Color="#2F7DE1"/>
 <SolidColorBrush x:Key="AccentHoverBrush" Color="#2A6FCA"/>
 <SolidColorBrush x:Key="AccentPressedBrush" Color="#245CB0"/>
 <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EAF2FD"/>
 <SolidColorBrush x:Key="AccentBorderBrush" Color="#BBD5F5"/>

 <!-- 语义色：状态文本与选中态，浅底用于底色 -->
 <SolidColorBrush x:Key="SuccessBrush" Color="#1F9254"/>
 <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E8F5EE"/>
 <SolidColorBrush x:Key="WarningBrush" Color="#B7791F"/>
 <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FCF4E4"/>
 <SolidColorBrush x:Key="DangerBrush" Color="#D13438"/>
 <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FCECEC"/>
 <SolidColorBrush x:Key="DangerBorderBrush" Color="#F0BFBF"/>

 <!-- 圆角：小（内联控件）/ 中（按钮、输入框）/ 大（卡片） -->
 <CornerRadius x:Key="RadiusSm">4</CornerRadius>
 <CornerRadius x:Key="RadiusMd">6</CornerRadius>
 <CornerRadius x:Key="RadiusLg">10</CornerRadius>

 <!-- 间距统一按 4 的倍数（4/8/12/16/24）就地书写，不单独建令牌，避免 Margin 语义歧义 -->

 <!-- 字号 -->
 <sys:Double x:Key="FontPageTitle">20</sys:Double>
 <sys:Double x:Key="FontSection">15</sys:Double>
 <sys:Double x:Key="FontBody">13</sys:Double>
 <sys:Double x:Key="FontCaption">12</sys:Double>
 <sys:Double x:Key="FontMono">12</sys:Double>

 <!-- 控件通用尺寸 -->
 <sys:Double x:Key="ControlHeight">34</sys:Double>

 <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Mono, Courier New</FontFamily>
</ResourceDictionary>
