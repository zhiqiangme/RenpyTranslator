<!--
  深色主题色板：与 Themes/Light.xaml 保持完全一致的资源键集合。
  中性炭黑外框（标题栏与侧边栏）配合略浅的主工作区与卡片层次，兼顾低眩光与高对比度。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <!-- 表面层级：外框（标题栏与侧边栏） → 主工作区底 → 卡片面 → 次级面 → 凹陷面 -->
 <SolidColorBrush x:Key="ChromeBrush" Color="#141417"/>
 <SolidColorBrush x:Key="WindowBrush" Color="#1C1C20"/>
 <SolidColorBrush x:Key="SurfaceBrush" Color="#242429"/>
 <SolidColorBrush x:Key="SurfaceAltBrush" Color="#18181C"/>
 <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#16161A"/>

 <!-- 交互反馈底色：悬停 / 按下 / 叠加层 -->
 <SolidColorBrush x:Key="HoverBrush" Color="#2C2C33"/>
 <SolidColorBrush x:Key="PressedBrush" Color="#35353E"/>
 <SolidColorBrush x:Key="OverlayBrush" Color="#FFFFFF"/>

 <!-- 边框：常规 / 强调（输入框描边） / 悬停 -->
 <SolidColorBrush x:Key="BorderBrush" Color="#2D2D35"/>
 <SolidColorBrush x:Key="BorderStrongBrush" Color="#3C3C47"/>
 <SolidColorBrush x:Key="BorderHoverBrush" Color="#525261"/>

 <!-- 文字层级 -->
 <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECEEF2"/>
 <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A6B2"/>
 <SolidColorBrush x:Key="TextTertiaryBrush" Color="#727887"/>
 <SolidColorBrush x:Key="TextDisabledBrush" Color="#525663"/>
 <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF"/>

 <!-- 强调色：常态 / 悬停 / 按下 / 浅底（选中态） -->
 <SolidColorBrush x:Key="AccentBrush" Color="#4D8DF6"/>
 <SolidColorBrush x:Key="AccentHoverBrush" Color="#5E99F8"/>
 <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B7BE5"/>
 <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E2B42"/>
 <SolidColorBrush x:Key="AccentBorderBrush" Color="#2F4C7A"/>

 <!-- 语义色 -->
 <SolidColorBrush x:Key="SuccessBrush" Color="#34C77B"/>
 <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#172E22"/>
 <SolidColorBrush x:Key="WarningBrush" Color="#E5A93B"/>
 <SolidColorBrush x:Key="WarningSubtleBrush" Color="#332814"/>
 <SolidColorBrush x:Key="DangerBrush" Color="#F06064"/>
 <SolidColorBrush x:Key="DangerSubtleBrush" Color="#351B1D"/>
 <SolidColorBrush x:Key="DangerBorderBrush" Color="#662E31"/>

 <!-- 自定义标题栏按钮 -->
 <SolidColorBrush x:Key="TitleBarButtonHoverBrush" Color="#2A2A32"/>
 <SolidColorBrush x:Key="TitleBarButtonPressedBrush" Color="#34343E"/>
 <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="#E81123"/>
 <SolidColorBrush x:Key="CloseButtonPressedBrush" Color="#C50F1F"/>
 <SolidColorBrush x:Key="CloseButtonHoverForegroundBrush" Color="#FFFFFF"/>

 <!-- 滚动条 -->
 <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3F3F4B"/>
 <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#545464"/>
 <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#6B6B7E"/>

 <!-- 提示气泡与 Markdown 渲染 -->
 <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#2E2E36"/>
 <SolidColorBrush x:Key="TooltipForegroundBrush" Color="#ECEEF2"/>
 <SolidColorBrush x:Key="TooltipBorderBrush" Color="#444450"/>
 <SolidColorBrush x:Key="CodeBlockBackgroundBrush" Color="#16161A"/>
 <SolidColorBrush x:Key="HyperlinkBrush" Color="#6AA3FF"/>
</ResourceDictionary>
