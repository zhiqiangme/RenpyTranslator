<!--
  线性矢量图标：统一绘制在 16×16 网格上，使用时设置 Stretch="None"、Width/Height=16，
  保证各图标笔画粗细与视觉大小一致。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

 <!-- 游戏管理：文件夹 -->
 <Geometry x:Key="IconGame">M2.6,11.4 V4.6 H6.3 L7.9,6.4 H13.4 V11.4 Z</Geometry>

 <!-- 模型 API：尖括号 -->
 <Geometry x:Key="IconApi">M6.1,4.2 L3,8 L6.1,11.8 M9.9,4.2 L13,8 L9.9,11.8</Geometry>

 <!-- 高级设置：三条滑轨加两个调节点 -->
 <Geometry x:Key="IconTune">M2.6,4.6 H13.4 M2.6,8 H13.4 M2.6,11.4 H13.4 M5.6,3 V6.2 M10.4,6.4 V9.6</Geometry>

 <!-- 更新：下载箭头与托板 -->
 <Geometry x:Key="IconUpdate">M8,2.8 V9.6 M5.1,6.9 L8,9.8 L10.9,6.9 M3,11.7 V12.9 H13 V11.7</Geometry>

 <!-- 数据与日志：文档 -->
 <Geometry x:Key="IconData">M4.2,2.8 H9.2 L11.9,5.5 V13.2 H4.2 Z M9.2,2.8 V5.5 H11.9 M6.3,8.2 H9.8 M6.3,10.4 H9.8</Geometry>

 <!-- 状态栏：勾选 -->
 <Geometry x:Key="IconCheck">M3.4,8.4 L6.6,11.6 L12.6,4.6</Geometry>

 <!-- 提示：感叹号 -->
 <Geometry x:Key="IconInfo">M8,4.4 V8.6 M8,11.3 V11.6</Geometry>
</ResourceDictionary>
