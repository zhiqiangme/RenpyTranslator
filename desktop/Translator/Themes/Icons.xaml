<!--
  线性矢量图标：常规图标统一绘制在 16×16 网格上，窗口控制图标绘制在 10×10 网格上，
  使用时设置 Stretch="None"，保证各图标笔画粗细与视觉大小一致。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

 <!-- 游戏管理：文件夹 -->
 <Geometry x:Key="IconGame">M2.6,11.4 V4.6 H6.3 L7.9,6.4 H13.4 V11.4 Z</Geometry>

 <!-- 模型 API：尖括号 -->
 <Geometry x:Key="IconApi">M6.1,4.2 L3,8 L6.1,11.8 M9.9,4.2 L13,8 L9.9,11.8</Geometry>

 <!-- 高级设置：三条滑轨加两个调节点 -->
 <Geometry x:Key="IconTune">M2.6,4.6 H13.4 M2.6,8 H13.4 M2.6,11.4 H13.4 M5.6,3 V6.2 M10.4,6.4 V9.6</Geometry>

 <!-- 更新：下载箭头与托板 -->
 <Geometry x:Key="IconUpdate">M8,2.8 V9.6 M5.1,6.9 L8,9.8 L10.9,6.9 M3,11.7 V12.9 H13 V11.7</Geometry>

 <!-- 数据与日志：文档 -->
 <Geometry x:Key="IconData">M4.2,2.8 H9.2 L11.9,5.5 V13.2 H4.2 Z M9.2,2.8 V5.5 H11.9 M6.3,8.2 H9.8 M6.3,10.4 H9.8</Geometry>

 <!-- 状态栏：勾选 -->
 <Geometry x:Key="IconCheck">M3.4,8.4 L6.6,11.6 L12.6,4.6</Geometry>

 <!-- 提示：感叹号 -->
 <Geometry x:Key="IconInfo">M8,4.4 V8.6 M8,11.3 V11.6</Geometry>

 <!-- 标题栏：侧边栏切换（16×16） -->
 <Geometry x:Key="IconSidebar">M2.5,3.5 H13.5 V12.5 H2.5 Z M6.2,3.5 V12.5</Geometry>

 <!-- 主题模式：跟随系统（显示器） / 浅色（太阳） / 深色（月亮）（16×16） -->
 <Geometry x:Key="IconThemeSystem">M2.6,3.5 H13.4 V10.3 H2.6 Z M5.8,12.8 H10.2 M8,10.3 V12.8</Geometry>
 <Geometry x:Key="IconThemeLight">M8,5.2 A2.8,2.8 0 1 1 7.99,5.2 Z M8,2.2 V3.4 M8,12.6 V13.8 M2.2,8 H3.4 M12.6,8 H13.8 M3.9,3.9 L4.8,4.8 M11.2,11.2 L12.1,12.1 M12.1,3.9 L11.2,4.8 M4.8,11.2 L3.9,12.1</Geometry>
 <Geometry x:Key="IconThemeDark">M11.8,9.9 A4.6,4.6 0 0 1 6.1,4.2 A4.6,4.6 0 1 0 11.8,9.9 Z</Geometry>

 <!-- 窗口控制按钮（10×10，1px 锐利线条） -->
 <Geometry x:Key="IconWinMinimize">M0,5 H10</Geometry>
 <Geometry x:Key="IconWinMaximize">M0.5,0.5 H9.5 V9.5 H0.5 Z</Geometry>
 <Geometry x:Key="IconWinRestore">M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5</Geometry>
 <Geometry x:Key="IconWinClose">M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5</Geometry>
</ResourceDictionary>
